{
  "manifest_version": 2,
  "name": "__MSG_extName__",
  "version": "0.9.0",
  "description": "__MSG_extDesc__",
  "browser_specific_settings": {
    "gecko": {
      "id": "snap-split@xdolly.local",
      "strict_min_version": "115.0",
      "data_collection_permissions": {
        "required": [
          "none"
        ]
      }
    }
  },
  "permissions": [
    "tabs",
    "tabGroups",
    "menus",
    "storage",
    "webNavigation",
    "webRequest",
    "webRequestBlocking",
    "<all_urls>",
    "theme"
  ],
  "background": {
    "scripts": [
      "background.js"
    ]
  },
  "browser_action": {
    "default_icon": "icon.svg",
    "default_title": "__MSG_actionTitle__",
    "default_popup": "popup.html"
  },
  "commands": {
    "_execute_browser_action": {
      "suggested_key": {
        "default": "Alt+Shift+Z"
      },
      "description": "__MSG_cmdOpen__"
    }
  },
  "icons": {
    "48": "icon.svg",
    "96": "icon.svg"
  },
  "default_locale": "en"
}

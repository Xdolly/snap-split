{
  "manifest_version": 2,
  "name": "Snap Split",
  "version": "0.8.1",
  "description": "แบ่งหน้า Firefox หลายช่องในแท็บเดียว เลือกรูปแบบแบบ Windows 11 (Win+Z)",
  "browser_specific_settings": {
    "gecko": {
      "id": "snap-split@xdolly.local",
      "strict_min_version": "115.0",
      "data_collection_permissions": {
        "required": [
          "none"
        ]
      }
    }
  },
  "permissions": [
    "tabs",
    "tabGroups",
    "menus",
    "storage",
    "webNavigation",
    "webRequest",
    "webRequestBlocking",
    "<all_urls>",
    "theme"
  ],
  "background": {
    "scripts": [
      "background.js"
    ]
  },
  "browser_action": {
    "default_icon": "icon.svg",
    "default_title": "Snap Split — เลือกรูปแบบแบ่งหน้า",
    "default_popup": "popup.html"
  },
  "commands": {
    "_execute_browser_action": {
      "suggested_key": {
        "default": "Alt+Shift+Z"
      },
      "description": "เปิดเมนูเลือกรูปแบบ"
    }
  },
  "icons": {
    "48": "icon.svg",
    "96": "icon.svg"
  }
}
